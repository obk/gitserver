# Anubis instance for gitserver: /etc/anubis/gitserver.env
# install.sh fills in DOMAIN and a persistent ED25519 key on first install,
# and leaves this file alone afterwards.
BIND=127.0.0.1:8923
BIND_NETWORK=tcp
TARGET=http://127.0.0.1:8080
POLICY_FNAME=/etc/anubis/gitserver.botPolicies.yaml
DIFFICULTY=4
# Default is :9090 on all interfaces; keep metrics local.
METRICS_BIND=127.0.0.1:9091
METRICS_BIND_NETWORK=tcp
# Serve a robots.txt that disallows all crawlers. Set to false if you want
# public repositories indexed by search engines.
SERVE_ROBOTS_TXT=true
REDIRECT_DOMAINS=git.example.com
# Keeps challenge cookies valid across restarts.
ED25519_PRIVATE_KEY_HEX=@KEY@
