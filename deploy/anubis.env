# Anubis instance for gitserver: /etc/anubis/gitserver.env
# install.sh fills in DOMAIN and a persistent ED25519 key on first install,
# and leaves this file alone afterwards, except for the socket settings
# below, which it keeps as they are here.
#
# Caddy -> Anubis -> gitserver talk over Unix sockets, not localhost ports.
# The sockets belong to the gitserver-http group (Anubis runs with it, see
# anubis-gitserver.conf), so no other local user can connect.
BIND=/run/anubis/gitserver/anubis.sock
BIND_NETWORK=unix
SOCKET_MODE=0660
TARGET=unix:///run/gitserver/http.sock
POLICY_FNAME=/etc/anubis/gitserver.botPolicies.yaml
DIFFICULTY=4
# Default is :9090 on all interfaces; keep metrics on a local socket.
METRICS_BIND=/run/anubis/gitserver/metrics.sock
METRICS_BIND_NETWORK=unix
# Serve a robots.txt that disallows all crawlers. Set to false if you want
# public repositories indexed by search engines.
SERVE_ROBOTS_TXT=true
REDIRECT_DOMAINS=git.example.com
# Keeps challenge cookies valid across restarts.
ED25519_PRIVATE_KEY_HEX=@KEY@
